# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Upstream provider
# Leave these as placeholders in Git.
UPSTREAM_BASE_URL=http://mock-provider:9000
UPSTREAM_API_KEY=
UPSTREAM_MODEL=mock-model

# Overload protection
MAX_IN_FLIGHT=2
PROCESS_MAX_IN_FLIGHT=50

# Total time budget for choosing an upstream provider
ROUTING_TIMEOUT_SECONDS=5

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=5

# Optional fallback LLM provider
FALLBACK_UPSTREAM_BASE_URL=
FALLBACK_UPSTREAM_API_KEY=
